# App
NEXT_PUBLIC_APP=personal-overleaf

# LaTeX compile (see src/lib/compiler.ts)
# Docker image with a full TeX Live install. Pull it once:
#   docker pull texlive/texlive:latest
# Then set it here. Default in code is localhost/latexforge/texlive:2024.
TEXLIVE_IMAGE=texlive/texlive:latest

# Per-compile timeout in seconds (default 120)
COMPILE_TIMEOUT=120

# Docker socket (default /var/run/docker.sock).
# Uncomment only if your socket lives elsewhere:
# DOCKER_HOST=unix:///var/run/docker.sock
